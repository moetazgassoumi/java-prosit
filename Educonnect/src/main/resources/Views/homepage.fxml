<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.Controllers.HomepageController"
>
    <stylesheets>
        <URL value="@../styles/styles.css" />
    </stylesheets>

    <!-- Main container with center alignment and spacing -->
    <VBox alignment="CENTER" spacing="30" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Title Section -->
        <Text text="Welcome to EduConnect" styleClass="title">
            <font>
                <Font size="24" />
            </font>
        </Text>

        <!-- Buttons section: Events, Courses, Reclamations, and Profile -->
        <HBox alignment="CENTER" spacing="40" styleClass="button-container">
            <Button fx:id="eventsButton" text="EVENTS" styleClass="menu-button" />
            <Button fx:id="coursesButton" text="COURSES" styleClass="menu-button" />
            <Button fx:id="reclamationsButton" text="RECLAMATIONS" styleClass="menu-button" />
            <Button fx:id="profileButton" text="PROFILE" styleClass="menu-button" onAction="#handleProfileButton"/> <!-- New Profile Button -->
        </HBox>

    </VBox>
</AnchorPane>
