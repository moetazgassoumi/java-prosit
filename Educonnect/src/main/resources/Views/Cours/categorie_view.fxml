<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.Controllers.Mayssa.CategorieController">
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Text fill="WHITE" text="Gestion des Catégories" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <GridPane hgap="10" vgap="10">
                <Label text="Nom Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                    <Button fx:id="updateButton" text="Modifier" onAction="#handleUpdate" style="-fx-background-color: #3498db; -fx-text-fill: white;" disable="true"/>
                    <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" disable="true"/>
                    <Button fx:id="clearButton" text="Vider" onAction="#handleClear" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                </HBox>
            </GridPane>

            <TableView fx:id="categorieTable" style="-fx-padding: 10;">
                <columns>
                    <TableColumn fx:id="nomColumn" text="Nom Catégorie" style="-fx-font-weight: bold;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>