<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.educonnect.educonnect.Controllers.UserTableController">

    <!-- En-tête avec rôle et recherche -->
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Filtrer par rôle :" style="-fx-font-size: 14px;"/>
                <ComboBox fx:id="roleFilterComboBox" promptText="Choisir un rôle" onAction="#handleRoleSelection"/>

                <Label text="Rechercher :" style="-fx-font-size: 14px;"/>
                <TextField fx:id="searchField" promptText="CIN, Email ou Téléphone" onKeyReleased="#handleSearch"/>
            </HBox>

            <Label fx:id="roleLabel" text="Rôle sélectionné" style="-fx-font-size: 18px;"/>
        </VBox>
    </top>

    <!-- Tableau des utilisateurs -->
    <center>
        <TableView fx:id="userTableView" prefHeight="400">
            <columns>
                <TableColumn fx:id="nomColumn" text="Nom"/>
                <TableColumn fx:id="prenomColumn" text="Prénom"/>
                <TableColumn fx:id="emailColumn" text="Email"/>
                <TableColumn fx:id="cinColumn" text="CIN"/>
                <TableColumn fx:id="telColumn" text="Téléphone"/>
                <TableColumn fx:id="lieuColumn" text="Lieu"/>
                <TableColumn fx:id="adresseColumn" text="Adresse"/>
                <TableColumn fx:id="dateNssColumn" text="Date Naissance"/>
                <TableColumn fx:id="roleColumn" text="Rôle"/>
                <TableColumn fx:id="specialiteColumn" text="Spécialité" visible="false"/>
                <TableColumn fx:id="salaireColumn" text="Salaire" visible="false"/>
            </columns>
        </TableView>
    </center>

    <!-- Formulaire de mise à jour et boutons -->
    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10">
                <Label text="Email:"/>
                <TextField fx:id="emailField" promptText="Modifier l'email"/>
                <Label text="Téléphone:"/>
                <TextField fx:id="telField" promptText="Modifier le téléphone"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Photo:"/>
                <TextField fx:id="photoField" promptText="Modifier le chemin de l'image"/>
                <Button fx:id="browseBtn" text="Parcourir" onAction="#handleBrowse"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="updateBtn" text="Mettre à jour" onAction="#handleUpdate"/>
                <Button fx:id="deleteBtn" text="Supprimer" onAction="#handleDelete"/>
                <Button text="Exporter en PDF" onAction="#handleExportPDF"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
