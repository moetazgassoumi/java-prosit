<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import io.github.palexdev.materialfx.dialogs.MFXGenericDialog?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.example.educonnect.educonnect.Controllers.UseraccountController"
            stylesheets="@../Style/userAccount.css"

            prefHeight="800.0" prefWidth="1300.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f2f9ff, #d6e6ff);">

    <!-- Sidebar -->
    <left>
        <VBox spacing="20" alignment="TOP_CENTER" prefWidth="220" style="-fx-background-color: #2C3E50;">
            <padding>
                <Insets top="30" bottom="30" left="15" right="15"/>
            </padding>
            <Button fx:id="Home_Btn" text="Accueil" styleClass="sidebar-button"/>
            <Button fx:id="Users_Btn" text="Utilisateurs" styleClass="sidebar-button"/>
            <Button fx:id="Reclamations_Btn" text="Réclamations" styleClass="sidebar-button"/>
            <Button fx:id="Events_Btn" text="Événements" styleClass="sidebar-button"/>
            <Button fx:id="Logout_Btn" text="Déconnexion" onAction="#onLogoutButtonClick" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="30" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" left="30" right="30"/>
            </padding>

            <Label fx:id="user_name" text="Bienvenue, User"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <HBox spacing="40" alignment="CENTER">

                <!-- Profile Card -->
                <VBox spacing="20" alignment="TOP_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);" prefWidth="450">
                    <padding>
                        <Insets top="30" left="30" right="30" bottom="30"/>
                    </padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Email :" prefWidth="100"/>
                        <TextField fx:id="tf_UserAccountEmail" prefWidth="250"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Téléphone :" prefWidth="100"/>
                        <TextField fx:id="tf_UserAccountNumero" prefWidth="250"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Photo Profil :" prefWidth="100"/>
                        <Button fx:id="ChangeImageBtn" text="Changer" onAction="#changeImage"/>
                    </HBox>

                    <ImageView fx:id="ImageviewUser" fitWidth="100" fitHeight="100"
                               style="-fx-border-color: #1E90FF; -fx-border-width: 2; -fx-border-radius: 50; -fx-background-radius: 50;"/>

                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="Update_AccountUser" text="Mettre à jour" styleClass="action-button"/>
                        <Button fx:id="ConfirmerD0_AccountUser1" text="Supprimer compte" onAction="#afficherDeleteDialog" styleClass="action-button"/>
                    </HBox>
                </VBox>

                <!-- Face Recognition Card -->
                <VBox spacing="20" alignment="TOP_CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);" prefWidth="300">
                    <padding>
                        <Insets top="30" left="30" right="30" bottom="30"/>
                    </padding>

                    <Label text="Reconnaissance faciale"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                    <Button fx:id="takePhotoButton" text="Configurer" styleClass="face-recognition-button"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

    <!-- Dialog Confirm Delete -->
    <children>
        <MFXGenericDialog fx:id="DialogConfirm_Delete" visible="false" layoutX="400" layoutY="300" prefWidth="400"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">
            <content>
                <VBox spacing="20" alignment="CENTER">
                    <Label text="Voulez-vous vraiment supprimer votre compte ?" style="-fx-font-size: 16px; -fx-text-fill: #2C3E50;"/>
                    <HBox spacing="20" alignment="CENTER">
                        <Button text="Annuler" onAction="#closeDeleteD" styleClass="action-button"/>
                        <Button text="Confirmer" onAction="#deleteUser" styleClass="action-button"/>
                    </HBox>
                </VBox>
            </content>
        </MFXGenericDialog>

        <!-- Dialog Face Setup -->
        <MFXGenericDialog fx:id="faceSetupDialog" visible="false" layoutX="300" layoutY="100" prefWidth="700" prefHeight="500"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);">
            <content>
                <VBox spacing="20" alignment="CENTER">
                    <Label text="Capture du Visage" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <ImageView fx:id="webcamPreview" fitWidth="500" fitHeight="300"/>
                    <Label fx:id="statusLabel" text="Positionnez votre visage" style="-fx-font-size: 14px;"/>
                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="captureButton" text="Capturer"/>
                        <Button fx:id="saveButton" text="Sauvegarder" disable="true"/>
                        <Button fx:id="closeFaceDialogButton" text="Fermer"/>
                    </HBox>
                </VBox>
            </content>
        </MFXGenericDialog>
    </children>

</BorderPane>
