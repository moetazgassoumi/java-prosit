<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.educonnect.educonnect.Controllers.SignupController"
           stylesheets="@../Style/signup.css"
           styleClass="background-pane">

    <VBox alignment="CENTER" spacing="20" StackPane.alignment="CENTER">

        <!-- 🧩 Card élargie -->
        <VBox alignment="CENTER" spacing="15" maxWidth="600" style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 20; -fx-padding: 40;">
            <Label text="EduConnect" styleClass="header-label"/>

            <Label text="Inscription" textFill="#1E90FF">
                <font>
                    <Font size="22.0"/>
                </font>
            </Label>

            <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" vbarPolicy="AS_NEEDED" prefHeight="550" maxWidth="550" style="-fx-background-color: transparent;">
                <VBox alignment="CENTER" spacing="15">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <TextField fx:id="nomField" promptText="Entrez votre nom" styleClass="custom-textfield"/>
                    <Label fx:id="nomErrorLabel" textFill="red" style="-fx-font-size: 10px;"/>

                    <TextField fx:id="prenomField" promptText="Entrez votre prénom" styleClass="custom-textfield"/>
                    <Label fx:id="prenomErrorLabel" textFill="red" style="-fx-font-size: 10px;"/>

                    <TextField fx:id="emailField" promptText="Entrez votre email" styleClass="custom-textfield"/>
                    <Label fx:id="emailErrorLabel" textFill="red" style="-fx-font-size: 10px;"/>

                    <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="custom-textfield"/>
                    <TextField fx:id="visiblePasswordField" promptText="Mot de passe" styleClass="custom-textfield" visible="false" managed="false"/>
                    <CheckBox fx:id="showPasswordCheckBox" text="Afficher le mot de passe" onAction="#togglePasswordVisibility"/>
                    <Label fx:id="passwordErrorLabel" textFill="red" style="-fx-font-size: 10px;"/>

                    <PasswordField fx:id="confirmPasswordField" promptText="Confirmez le mot de passe" styleClass="custom-textfield"/>
                    <Label fx:id="confirmPasswordErrorLabel" textFill="red" style="-fx-font-size: 10px;"/>

                    <TextField fx:id="cinField" promptText="CIN" styleClass="custom-textfield"/>
                    <TextField fx:id="telephoneField" promptText="Téléphone" styleClass="custom-textfield"/>
                    <DatePicker fx:id="dateNssPicker" promptText="Date de naissance" styleClass="custom-textfield"/>

                    <ComboBox fx:id="lieuComboBox" promptText="Lieu de naissance" styleClass="custom-textfield"/>
                    <TextField fx:id="adresseField" promptText="Adresse complète" styleClass="custom-textfield"/>

                    <ComboBox fx:id="roleComboBox" promptText="Rôle" styleClass="custom-textfield"/>

                    <TextField fx:id="specialiteField" promptText="Votre spécialité" styleClass="custom-textfield"/>
                    <TextField fx:id="salaireField" promptText="Salaire" styleClass="custom-textfield"/>

                    <HBox spacing="8">
                        <TextField fx:id="photoField" promptText="Chemin de la photo" styleClass="custom-textfield" HBox.hgrow="ALWAYS"/>
                        <Button text="Parcourir" onAction="#handlePhotoBrowse" styleClass="custom-button"/>
                    </HBox>

                    <VBox spacing="5">
                        <ProgressBar fx:id="passwordStrengthBar" prefWidth="300"/>
                        <Label fx:id="passwordStrengthLabel" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    </VBox>

                    <Button text="S'inscrire" onAction="#handleSignup" styleClass="custom-button"/>

                    <!-- 🌟 Lien pour aller vers Login -->
                    <Hyperlink text="Déjà inscrit ? Se connecter"
                               onMouseClicked="#onLoginLinkClick"
                               style="-fx-text-fill: #1E90FF; -fx-font-size: 12px; -fx-underline: true;"/>

                </VBox>
            </ScrollPane>
        </VBox>

    </VBox>
</StackPane>
